# McBeat Environment Variables
# Copy this to .env and fill in your values

# App
APP_ENV=development
APP_SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://mcbeat:password@localhost:5432/mcbeat_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mcbeat-assets
R2_PUBLIC_URL=https://assets.mcbeat.io

# AI Services — BYOK Model
# McBeat does NOT use its own AI keys in production.
# These are only used for local development/testing.
# In production, each user provides their own keys via the Settings UI.
OPENAI_API_KEY=your-openai-key-for-dev-only
ANTHROPIC_API_KEY=your-anthropic-key-for-dev-only

# Key Encryption
AES_ENCRYPTION_KEY=your-32-char-encryption-key-here

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRY_HOURS=24

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
